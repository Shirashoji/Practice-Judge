# docker compose用の環境変数（cp .env.example .env して編集する）
# ローカルで動かすだけなら未設定（デフォルト値）でも動く。

# セッションcookieの署名キー。本番では必ずランダムな値に変更すること。
SESSION_SECRET=

# CORSで許可するフロントのオリジン。
# 本番相当(compose.yamlのみ)のデフォルト: http://localhost:3000
# 開発(override込み)ではhttp://localhost:5173が自動で使われる。
FRONTURL=

# フロントのビルドに焼き込むAPIのURL（ブラウザから見えるURL）。
# デフォルト: http://localhost:8181
VITE_BASEURL=

# HTTPS付きの実デプロイ時のみ production を設定する。
# （http+localhostで設定するとsecure cookie強制によりログインできなくなる）
NODE_ENV=

# 開発モードのフロント公開ポート（他プロジェクトと5173が衝突する場合に変更）。
# デフォルト: 5173
FRONT_DEV_PORT=

# ============================================================
# LLM学習支援機能
# ============================================================

# 呼び出し経路はモデルの系列ごとに決まる。設定した経路のモデルだけが選択肢に出るので、
# Claude・Gemini・ローカルLLMを同時に有効にしておいて、ユーザーに選ばせることもできる。

# --- Claude ---

# Claudeをどこ経由で呼ぶか。anthropic（本家API） または vertex（Vertex AI）。
# デフォルト: anthropic
# 注: この値はClaudeの経路だけを決める。Geminiとローカルの経路には影響しない。
LLM_PROVIDER=

# Anthropic本家APIのキー。LLM_PROVIDER=anthropic のとき必須。
ANTHROPIC_API_KEY=

# --- Vertex AI（Claude / Gemini 共通） ---

# GCPプロジェクトとリージョン。認証はGCPのADC（gcloud auth application-default login）を使う。
# LLM_PROVIDER=vertex でClaudeを使う場合と、Vertex経由でGeminiを使う場合に設定する。
# ここが設定されていればGeminiは自動的にVertex経由になる。
# REGIONのデフォルト: global
VERTEX_PROJECT_ID=
VERTEX_REGION=

# --- Gemini（Vertexを使わない場合） ---

# Gemini Developer APIのキー。VERTEX_PROJECT_ID が未設定のときだけ使われる
# （両方設定されている場合はVertexが優先）。
GEMINI_API_KEY=

# --- ローカルLLM（LM Studio等のOpenAI互換サーバ） ---

# OpenAI互換エンドポイントのURL（/v1 まで）。
# LM Studioの既定は http://localhost:1234/v1 だが、APIはコンテナの中で動くので
# ホストのLM Studioを指す場合は host.docker.internal を使う。
#   例: http://host.docker.internal:1234/v1
LOCAL_LLM_BASE_URL=

# 認証しないサーバがほとんどなので通常は空でよい。デフォルト: local
LOCAL_LLM_API_KEY=

# 使わせるモデルIDをカンマ区切りで列挙する（LM Studioの /v1/models に出るIDと同じもの）。
# ここに書いたものだけが管理画面の選択肢に出る。自動検出にしていないのは、
# 起動時にローカルサーバが落ちていると選択肢が空のままAPIが立ち上がってしまうため。
#   例: qwen/qwen3-coder-30b,openai/gpt-oss-20b
LOCAL_LLM_MODELS=

# 対話・ヒント生成に使うモデルのフォールバック既定。
# 実際のモデルは「ユーザーの選択 > 管理画面の難易度別マッピング > ここ」の順で決まる。
# デフォルト: claude-opus-5
LLM_MODEL_CHAT=

# 違反判定などの軽量タスクに使うモデル。
# デフォルト: claude-haiku-4-5
LLM_MODEL_CLASSIFY=

# 注: 月次上限などの金額設定はenvではなくDB（llm_settings）に置き、管理画面から変更する。
