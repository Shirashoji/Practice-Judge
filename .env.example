# docker compose用の環境変数（cp .env.example .env して編集する）
# ローカルで動かすだけなら未設定（デフォルト値）でも動く。

# セッションcookieの署名キー。本番では必ずランダムな値に変更すること。
SESSION_SECRET=

# CORSで許可するフロントのオリジン。
# 本番相当(compose.yamlのみ)のデフォルト: http://localhost:3000
# 開発(override込み)ではhttp://localhost:5173が自動で使われる。
FRONTURL=

# フロントのビルドに焼き込むAPIのURL（ブラウザから見えるURL）。
# デフォルト: http://localhost:8181
VITE_BASEURL=

# HTTPS付きの実デプロイ時のみ production を設定する。
# （http+localhostで設定するとsecure cookie強制によりログインできなくなる）
NODE_ENV=

# 開発モードのフロント公開ポート（他プロジェクトと5173が衝突する場合に変更）。
# デフォルト: 5173
FRONT_DEV_PORT=

# ============================================================
# LLM学習支援機能
# ============================================================

# 使用するプロバイダ。anthropic（本家API） または vertex（Vertex AI上のClaude）。
# デフォルト: anthropic
LLM_PROVIDER=

# Anthropic本家APIのキー。LLM_PROVIDER=anthropic のとき必須。
ANTHROPIC_API_KEY=

# Vertex AI経由で使う場合のGCPプロジェクトとリージョン。
# LLM_PROVIDER=vertex のとき必須。認証はGCPのADC（gcloud auth application-default login）を使う。
# REGIONのデフォルト: global
VERTEX_PROJECT_ID=
VERTEX_REGION=

# 対話・ヒント生成に使うモデルのフォールバック既定。
# 実際のモデルは「ユーザーの選択 > 管理画面の難易度別マッピング > ここ」の順で決まる。
# デフォルト: claude-opus-5
LLM_MODEL_CHAT=

# 違反判定などの軽量タスクに使うモデル。
# デフォルト: claude-haiku-4-5
LLM_MODEL_CLASSIFY=

# 注: 月次上限などの金額設定はenvではなくDB（llm_settings）に置き、管理画面から変更する。
